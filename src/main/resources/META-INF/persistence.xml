<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

  <!--
    RESOURCE_LOCAL thay vi JTA:
    Tomcat khong phai full Jakarta EE server nen khong co JTA transaction manager.
    Dung RESOURCE_LOCAL + EntityManagerFactory tu quan ly transaction.
  -->
  <persistence-unit name="my_persistence_unit" transaction-type="RESOURCE_LOCAL">

    <class>com.mycompany.thanhtoannganhang.model.entity.TaiKhoan</class>
    <class>com.mycompany.thanhtoannganhang.model.entity.GiaoDich</class>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>

    <properties>
      <!-- Ket noi truc tiep MySQL, khong qua JNDI -->
      <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:mysql://sql8.freesqldatabase.com:3306/sql8838062?useSSL=false&amp;serverTimezone=Asia/Ho_Chi_Minh&amp;allowPublicKeyRetrieval=true&amp;characterEncoding=UTF-8"/>
      <property name="jakarta.persistence.jdbc.user"     value="sql8838062"/>
      <property name="jakarta.persistence.jdbc.password" value="jWTerlQLsm"/>

      <!-- EclipseLink (Hibernate tren Tomcat thuong dung EclipseLink hoac Hibernate) -->
      <property name="eclipselink.logging.level"     value="WARNING"/>
      <property name="eclipselink.logging.level.sql" value="WARNING"/>
      <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
    </properties>

  </persistence-unit>

</persistence>
